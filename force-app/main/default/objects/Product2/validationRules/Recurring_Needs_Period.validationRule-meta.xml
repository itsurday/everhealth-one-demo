<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata"><fullName>Recurring_Needs_Period</fullName><active>true</active><errorConditionFormula>(NOT(ISPICKVAL(Charge_Type__c, 'One-Time')) &amp;&amp; NOT(ISPICKVAL(Charge_Type__c, '')) &amp;&amp; ISPICKVAL(Billing_Period__c, '')) || (ISPICKVAL(Charge_Type__c, 'One-Time') &amp;&amp; NOT(ISPICKVAL(Billing_Period__c, '')))</errorConditionFormula><errorDisplayField>Billing_Period__c</errorDisplayField><errorMessage>Recurring and Usage charges need a Billing Period; One-Time charges must not have one.</errorMessage></ValidationRule>
