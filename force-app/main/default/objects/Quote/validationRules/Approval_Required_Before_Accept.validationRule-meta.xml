<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata"><fullName>Approval_Required_Before_Accept</fullName><active>true</active><errorConditionFormula>ISPICKVAL(Status, 'Accepted') &amp;&amp; Requires_Discount_Approval__c &amp;&amp; NOT(ISPICKVAL(Approval_Status__c, 'Approved'))</errorConditionFormula><errorMessage>This quote has a discount above the approval threshold. Get it approved before accepting.</errorMessage></ValidationRule>
