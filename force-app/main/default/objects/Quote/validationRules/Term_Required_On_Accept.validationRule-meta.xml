<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata"><fullName>Term_Required_On_Accept</fullName><active>true</active><errorConditionFormula>ISPICKVAL(Status, 'Accepted') &amp;&amp; (ISBLANK(Term_Months__c) || ISBLANK(Term_Start_Date__c))</errorConditionFormula><errorMessage>Term Months and Term Start Date are required before the quote can be accepted.</errorMessage></ValidationRule>
