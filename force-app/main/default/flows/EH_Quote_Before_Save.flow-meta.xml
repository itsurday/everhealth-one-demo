        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.Quote_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>QuoteTypeFromRecordType</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Only owner of Quote_Type__c defaulting (STA §4). Before-save on create: Opportunity record type New Business -&gt; New, Amendment -&gt; Amend, Renewal -&gt; Renew.</description>
    <environments>Default</environments>
    <formulas>
        <name>QuoteTypeFromRecordType</name>
