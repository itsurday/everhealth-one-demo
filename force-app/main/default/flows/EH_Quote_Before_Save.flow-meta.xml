        <expression>CASE({!$Record.Opportunity.RecordType.DeveloperName}, &apos;Amendment&apos;, &apos;Amend&apos;, &apos;Renewal&apos;, &apos;Renew&apos;, &apos;New&apos;)</expression>
    </formulas>
    <interviewLabel>EH Quote Before Save {!$Flow.CurrentDateTime}</interviewLabel>
