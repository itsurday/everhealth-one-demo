<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <decisions>
        <name>Inside_Renewal_Window</name>
        <label>Inside Renewal Window?</label>
        <locationX>182</locationX>
        <locationY>360</locationY>
        <defaultConnectorLabel>Not Yet</defaultConnectorLabel>
        <rules>
            <name>In_Window</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DaysToTermEnd</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Settings.Renewal_Lead_Days__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Renewal_Record_Type</targetReference>
            </connector>
            <label>In Window</label>
        </rules>
    </decisions>
    <description>Only owner of renewal Opportunity creation (STA §4). Daily: for each Active subscription without a renewal, within Q2C_Setting__mdt.Default.Renewal_Lead_Days__c of term end, create one Renewal Opportunity and link it. Idempotent: entry filter excludes linked subscriptions; Opportunity.Renewal_Key__c is unique as a backstop.</description>
    <environments>Default</environments>
    <formulas>
        <name>DaysToTermEnd</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Term_End_Date__c} - {!$Flow.CurrentDate}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>RenewalAmount</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!$Record.MRR__c}, 0) * 12</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>RenewalKey</name>
        <dataType>String</dataType>
        <expression>{!$Record.Subscription_Key__c} &amp; &apos;:&apos; &amp; TEXT({!$Record.Term_End_Date__c})</expression>
    </formulas>
    <formulas>
        <name>RenewalName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Account__r.Name} &amp; &apos; - Renewal &apos; &amp; TEXT(YEAR({!$Record.Term_End_Date__c}))</expression>
    </formulas>
    <interviewLabel>EH Renewal Generator {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EH Renewal Generator</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Renewal_Opportunity</name>
        <label>Create Renewal Opportunity</label>
        <locationX>50</locationX>
        <locationY>576</locationY>
        <connector>
            <targetReference>Link_Renewal</targetReference>
        </connector>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Amount</field>
            <value>
                <elementReference>RenewalAmount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CloseDate</field>
            <value>
                <elementReference>$Record.Term_End_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>RenewalName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>Get_Renewal_Record_Type.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Renewal_Key__c</field>
            <value>
                <elementReference>RenewalKey</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Source_Subscription__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Qualification</stringValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Renewal_Record_Type</name>
        <label>Get Renewal Record Type</label>
        <locationX>50</locationX>
        <locationY>468</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Renewal_Opportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Opportunity</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Renewal</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <queriedFields>Id</queriedFields>
